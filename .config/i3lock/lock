#!/bin/bash

set -e

I3_CONFIG="$HOME/.config/i3/config"

# Extract wallpaper path from i3 config
WALLPAPER=$(grep -Eo 'feh .* --bg-(scale|fill|center) [^ ]+' "$I3_CONFIG" | awk '{print $NF}')

if [ -z "$WALLPAPER" ]; then
    echo "No wallpaper defined in i3 config."
    exit 1
fi

case $WALLPAPER in "~"/*) WALLPAPER="$HOME/${WALLPAPER#"~/"}" ;; esac

WALLPAPER_DIR=$(dirname "$WALLPAPER")
WALLPAPER_BASENAME=$(basename "$WALLPAPER")
WALLPAPER_NAME="${WALLPAPER_BASENAME%.*}"

BLURRED_WALLPAPER="$WALLPAPER_DIR/${WALLPAPER_NAME}_blurred.png"

opts=(-i "$BLURRED_WALLPAPER" --ignore-empty-password --show-failed-attempts --pointer=win)

# Before suspend xss-lock passes a sleep lock (bash: its fd may be above 9). i3lock must not inherit it;
# closing ours once i3lock has forked (screen locked) lets suspend go ahead. Stay until unlock either way.
if [ -e "/dev/fd/${XSS_SLEEP_LOCK_FD:--1}" ]; then
    trap 'pkill -xu "$EUID" i3lock' TERM INT
    i3lock "${opts[@]}" {XSS_SLEEP_LOCK_FD}<&-
    exec {XSS_SLEEP_LOCK_FD}<&-
    while pkill -0 -xu "$EUID" i3lock; do sleep 0.5; done
else
    exec i3lock -n "${opts[@]}"
fi
