#!/bin/sh

# Load Xresources
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

# Use US International (altgr variant: dead keys only when AltGr held; avoids '+s → ś)
setxkbmap -layout us -variant altgr-intl

# Load fonts
[ -d "$HOME/.fonts" ] && xset +fp "$HOME/.fonts" 2>/dev/null || true
xset fp rehash

# Disable bell
xset -b

# Faster trackpad acceleration. Xsession sources this file under set -e: a missing device must not end the login.
touchpad=$(xinput list --name-only | grep -i -m1 touchpad) &&
    xinput --set-prop "$touchpad" "libinput Accel Speed" 0.125 || true

# Thunar mounts
if command -v thunar > /dev/null 2>&1; then
    if [ -z "${DBUS_SESSION_BUS_ADDRESS-}" ] && type dbus-launch >/dev/null; then
        eval "$(dbus-launch --sh-syntax --exit-with-session)"
    fi
fi

# If running from tty1 start i3wm
if [ "$(tty)" = "/dev/tty1" ]; then
    exec i3
fi
