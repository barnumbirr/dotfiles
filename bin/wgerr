#!/bin/sh
#
# wgerr - winget return code lookup (Symbol + Description)
#
# Data source:
#   https://github.com/microsoft/winget-cli/blob/master/doc/windows/package-manager/winget/returnCodes.md
# (raw) https://raw.githubusercontent.com/microsoft/winget-cli/master/doc/windows/package-manager/winget/returnCodes.md
#

set -eu

PROG_NAME="${0##*/}"
SRC_URL="https://raw.githubusercontent.com/microsoft/winget-cli/master/doc/windows/package-manager/winget/returnCodes.md"

die() {
  _die_rc=1
  case "${1-}" in [0-9]*) _die_rc="$1"; shift ;; esac
  printf '%s: error: %b\n' "$PROG_NAME" "$*" >&2
  exit "$_die_rc"
}

usage() {
  cat <<EOF
Usage: $PROG_NAME [options] WINGET_ERROR_CODE

Looks up a WinGet return code (HEX or Decimal) and prints its Symbol and Description.

Examples:
  $PROG_NAME 0x8A150001
  $PROG_NAME 8A150001
  $PROG_NAME -1978335231
  $PROG_NAME 2316632065   # unsigned decimal also accepted

Options:
  -V, --verbose    output debug information
  -h, --help       display this help message and exit
EOF
}

# Prints "0xHEX SIGNED_DECIMAL" for a code given in hex (with or without 0x) or decimal (signed or not)
normalize_code() {
  case "$1" in
    '' | *[!0-9A-Fa-fxX-]*) die 2 "not a return code: $1" ;;
    0x* | 0X* | -*) _nc_v=$(($1)) ;;
    *[A-Fa-f]*)     _nc_v=$((0x$1)) ;;
    *)              _nc_v=$(($1)) ;;
  esac
  _nc_u=$((_nc_v & 0xFFFFFFFF))
  printf '0x%08X %d\n' "$_nc_u" $((_nc_u > 0x7FFFFFFF ? _nc_u - 0x100000000 : _nc_u))
}

lookup_code() {
  _lc_hex="$1"
  _lc_dec="$2"

  _lc_md=$(curl -fsSL "$SRC_URL") || die "failed to fetch return codes from GitHub"

  printf '%s\n' "$_lc_md" | awk -v th="$_lc_hex" -v td="$_lc_dec" '
    function trim(s) { gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s); return s }

    BEGIN {
      found = 0
      sym = ""
      desc = ""
    }

    /^\|/ {
      n = split($0, a, "|")

      h = trim(a[2]); d = trim(a[3]); s = trim(a[4]); r = trim(a[5])

      if (h !~ /^0x[0-9A-Fa-f]+$/ && d ~ /^0x[0-9A-Fa-f]+$/) {
        h = trim(a[3]); d = trim(a[4]); s = trim(a[5]); r = trim(a[6])
      }

      if (tolower(h) == "hex") next
      if (h !~ /^0x[0-9A-Fa-f]+$/) next

      if (found) {
        collecting = 0
        next
      }

      if (toupper(h) == toupper(th) || d == td) {
        found = 1
        collecting = 1
        sym = s
        desc = r
      }
      next
    }

    {
      if (found && collecting) {
        line = trim($0)
        if (line != "") desc = desc " " line
      }
    }

    END {
      if (!found) exit 2
      desc = trim(desc)
      gsub(/[ \t\r\n]+/, " ", desc)
      printf "%s - %s\n", sym, desc
      exit 0
    }
  '
}

main() {
  _main_norm=$(normalize_code "$1")
  _main_hex=${_main_norm% *}
  _main_dec=${_main_norm#* }

  # Not an assignment that fails: under set -e that would exit before the unknown-code message
  _main_rc=0
  _main_out=$(lookup_code "$_main_hex" "$_main_dec") || _main_rc=$?

  case "$_main_rc" in
    0) printf '%s\n' "$_main_out" ;;
    2) die "unknown winget return code: $1 (hex=$_main_hex dec=$_main_dec)" ;;
    *) exit "$_main_rc" ;;
  esac
}

parse_params() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h | --help)    usage; exit 0 ;;
      -V | --verbose) set -x ;;
      -[0-9]*)        break ;;
      -?*) die 2 "unknown option: $1\nTry '$PROG_NAME -h' for more information." ;;
      *)   break ;;
    esac
    shift
  done

  [ "${1-}" ] || die 2 "WINGET_ERROR_CODE is required.\nTry '$PROG_NAME -h' for more information."

  main "$@"
}

parse_params "$@"
