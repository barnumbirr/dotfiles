#!/bin/sh
#
# vault - Pastebin-like service
# https://github.com/barnumbirr/vault
#

set -eu

PROG_NAME="${0##*/}"

die() {
  _die_rc=1
  case "${1-}" in [0-9]*) _die_rc="$1"; shift ;; esac
  printf '%s: error: %b\n' "$PROG_NAME" "$*" >&2
  exit "$_die_rc"
}

usage() {
  cat <<EOF
Usage: $PROG_NAME [options] [FILE]

Upload a file to vault.tf. Reads from stdin if no FILE is given.

Options:
  -d, --delete KEY       delete a document by key
  -e, --expiration TTL   set expiration in seconds (min 60)
  -V, --verbose          output debug information
  -h, --help             display this help message and exit

Environment:
  VAULT_SECRET_KEY       authorization secret (required)
  VAULT_URL              base URL (default: https://vault.tf)
EOF
}

_json_field() {
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$1" | jq -re ".$2"
  else
    printf '%s' "$1" | sed -n "s/.*\"$2\":\"\([^\"]*\)\".*/\1/p" | grep .
  fi
}

upload() {
  _upload_resp=$(curl --silent --show-error --fail-with-body --data-binary @"${1:--}" \
    -H "Authorization: $VAULT_SECRET_KEY" \
    ${EXPIRATION:+-H "Expiration: $EXPIRATION"} \
    "$_url/documents") || \
    die "failed to paste: $(_json_field "$_upload_resp" message 2>/dev/null || echo "unknown error")"

  _upload_key=$(_json_field "$_upload_resp" key 2>/dev/null) || die "failed to parse response"

  echo "$_url/$_upload_key"
}

delete() {
  _delete_resp=$(curl --silent --show-error --fail-with-body -X DELETE \
    -H "Authorization: $VAULT_SECRET_KEY" \
    "$_url/documents/$1") || \
    die "failed to delete: $(_json_field "$_delete_resp" message 2>/dev/null || echo "unknown error")"

  _json_field "$_delete_resp" message 2>/dev/null || echo "deleted '$1'"
}

main() {
  _url="${VAULT_URL:-https://vault.tf}"

  if [ -n "$DELETE_KEY" ]; then
    delete "$DELETE_KEY"
  else
    upload "${1:--}"
  fi
}

parse_params() {
  EXPIRATION=""
  DELETE_KEY=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h | --help)    usage; exit 0 ;;
      -V | --verbose) set -x ;;
      -e | --expiration)
        [ "${2-}" ] || die 2 "missing value after $1"
        EXPIRATION="$2"
        shift
        ;;
      -d | --delete)
        [ "${2-}" ] || die 2 "missing value after $1"
        DELETE_KEY="$2"
        shift
        ;;
      -?*) die 2 "unknown option: $1\nTry '$PROG_NAME -h' for more information." ;;
      *)   break ;;
    esac
    shift
  done

  [ "${VAULT_SECRET_KEY-}" ] || die "VAULT_SECRET_KEY is not set.\nTry '$PROG_NAME -h' for more information."

  main "$@"
}

parse_params "$@"
