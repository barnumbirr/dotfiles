#!/bin/sh
#
# 0xff - 0xff.tf CLI client
# https://github.com/barnumbirr/0xff
#

set -eu

PROG_NAME="${0##*/}"

msg() { printf '%s: %b\n' "$PROG_NAME" "$*" >&2; }

die() {
  _die_rc=1
  case "${1-}" in [0-9]*) _die_rc="$1"; shift ;; esac
  msg "error: $*"
  exit "$_die_rc"
}

usage() {
  cat <<EOF
Usage: $PROG_NAME [options] URL

Shorten, list, or delete URLs via 0xff.tf.

Options:
  -c, --custom SLUG   use a custom slug (https://0xff.tf/SLUG)
  -u, --update SLUG   update an existing slug's target URL
  -d, --delete SLUG   delete a short URL by slug
  -t, --ttl SECONDS   set expiration (minimum 60 seconds)
  -l, --list          list all your shortened URLs
  -p, --preview SLUG  preview a short URL (no redirect)
  -q, --qr SLUG       get a QR code (SVG) for a short URL

  -V, --verbose       output debug information
  -h, --help          display this help message and exit
EOF
}

_pretty_json() {
  if command -v jq >/dev/null 2>&1; then
    printf '%s\n' "$1" | jq
  elif command -v python >/dev/null 2>&1; then
    printf '%s\n' "$1" | python -m json.tool
  else
    msg "WARNING: Neither 'jq' nor 'python' installed"
    printf '%s\n' "$1"
  fi
}

_0xff() {
  _0xff_url="https://0xff.tf"

  # Preview and QR don't require auth
  if [ -n "$PREVIEW_SLUG" ]; then
    _0xff_raw=$(curl --silent --fail \
      "$_0xff_url/${PREVIEW_SLUG}?preview") || die "failed to preview slug '${PREVIEW_SLUG}'"
    _pretty_json "$_0xff_raw"
    return
  fi

  if [ -n "$QR_SLUG" ]; then
    curl --silent --fail \
      "$_0xff_url/${QR_SLUG}.qr" || die "failed to get QR code for slug '${QR_SLUG}'"
    return
  fi

  # Everything else requires auth
  [ "${SHORTENER_SECRET_KEY-}" ] || die "SHORTENER_SECRET_KEY is not set"

  if [ -n "$LIST" ]; then
    _0xff_raw=$(curl --silent --fail -X GET \
      -H "Authorization: ${SHORTENER_SECRET_KEY}" \
      "$_0xff_url") || die "failed to list short URLs"
    _pretty_json "$_0xff_raw"
    return
  fi

  if [ -n "$DELETE_SLUG" ]; then
    _0xff_raw=$(curl --silent --fail -X DELETE \
      -H "Authorization: ${SHORTENER_SECRET_KEY}" \
      "$_0xff_url/${DELETE_SLUG}") || die "failed to delete slug '${DELETE_SLUG}'"
    _pretty_json "$_0xff_raw"
    return
  fi

  if [ -n "$UPDATE_SLUG" ]; then
    _0xff_raw=$(curl --silent --fail -X PATCH \
      -H "Authorization: ${SHORTENER_SECRET_KEY}" \
      -H "URL: $1" ${TTL:+-H "TTL: $TTL"} \
      "$_0xff_url/${UPDATE_SLUG}") || die "failed to update slug '${UPDATE_SLUG}'"
    _pretty_json "$_0xff_raw"
    return
  fi

  if [ -n "$CUSTOM_SLUG" ]; then
    _0xff_method="PUT"
    _0xff_path="$_0xff_url/${CUSTOM_SLUG}"
  else
    _0xff_method="POST"
    _0xff_path="$_0xff_url"
  fi

  _0xff_resp=$(curl --silent --fail -X "$_0xff_method" \
    -H "Authorization: ${SHORTENER_SECRET_KEY}" \
    -H "URL: $1" ${TTL:+-H "TTL: $TTL"} \
    "$_0xff_path") || die "failed to shorten URL"

  _pretty_json "$_0xff_resp"
}

parse_params() {
  CUSTOM_SLUG=""
  DELETE_SLUG=""
  UPDATE_SLUG=""
  PREVIEW_SLUG=""
  QR_SLUG=""
  LIST=""
  TTL=""
  _pp_url=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h | --help)    usage; exit 0 ;;
      -V | --verbose) set -x ;;
      -c | --custom)
        [ "${2-}" ] || die "missing slug after $1"
        CUSTOM_SLUG="$2"
        shift
        ;;
      -u | --update)
        [ "${2-}" ] || die "missing slug after $1"
        UPDATE_SLUG="$2"
        shift
        ;;
      -d | --delete)
        [ "${2-}" ] || die "missing slug after $1"
        DELETE_SLUG="$2"
        shift
        ;;
      -t | --ttl)
        [ "${2-}" ] || die "missing seconds after $1"
        TTL="$2"
        shift
        ;;
      -p | --preview)
        [ "${2-}" ] || die "missing slug after $1"
        PREVIEW_SLUG="$2"
        shift
        ;;
      -q | --qr)
        [ "${2-}" ] || die "missing slug after $1"
        QR_SLUG="$2"
        shift
        ;;
      -l | --list) LIST="1" ;;
      -?*) die "unknown option: $1\nTry '$PROG_NAME -h' for more information." ;;
      *)   _pp_url="$1" ;;
    esac
    shift
  done

  if [ -n "$LIST" ] || [ -n "$DELETE_SLUG" ] || [ -n "$PREVIEW_SLUG" ] || [ -n "$QR_SLUG" ]; then
    _0xff
    return
  fi

  [ -n "$_pp_url" ] || die "URL is required unless listing, deleting, previewing, or getting QR.\nTry '$PROG_NAME -h' for more information."

  _0xff "$_pp_url"
}

parse_params "$@"
