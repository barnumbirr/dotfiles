#!/bin/sh
#
# 0xff - 0xff.tf CLI client
# https://github.com/barnumbirr/0xff
#

set -eu

PROG_NAME="${0##*/}"

msg() { printf '%s: %b\n' "$PROG_NAME" "$*" >&2; }

die() {
  _die_rc=1
  case "${1-}" in [0-9]*) _die_rc="$1"; shift ;; esac
  msg "error: $*"
  exit "$_die_rc"
}

# Prints field $2 of the JSON object $1, or fails.
_json_field() {
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$1" | jq -re ".$2"
  else
    printf '%s' "$1" | sed -n "s/.*\"$2\":\"\([^\"]*\)\".*/\1/p" | grep .
  fi
}

# The server's error message from response $1.
_why() {
  _json_field "$1" message 2>/dev/null || echo "unknown error"
}

usage() {
  cat <<EOF
Usage: $PROG_NAME [options] URL

Shorten, list, or delete URLs via 0xff.tf.

Options:
  -c, --custom SLUG   use a custom slug (https://0xff.tf/SLUG)
  -u, --update SLUG   update an existing slug's target URL (without -t it never expires)
  -d, --delete SLUG   delete a short URL by slug
  -t, --ttl SECONDS   set expiration (minimum 60 seconds)
  -l, --list          list all your shortened URLs
  -p, --preview SLUG  preview a short URL (no redirect)
  -q, --qr SLUG       get a QR code (SVG) for a short URL

  -V, --verbose       output debug information
  -h, --help          display this help message and exit
EOF
}

_pretty_json() {
  if command -v jq >/dev/null 2>&1; then
    printf '%s\n' "$1" | jq
  elif command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "$1" | python3 -m json.tool
  else
    msg "WARNING: Neither 'jq' nor 'python3' installed"
    printf '%s\n' "$1"
  fi
}

# A request to 0xff.tf: _api METHOD PATH [curl options]. Prints the body; fails on an HTTP error.
_api() {
  _api_method=$1 _api_path=$2
  shift 2
  curl --silent --show-error --fail-with-body -X "$_api_method" \
    ${AUTH:+-H "Authorization: $AUTH"} "$@" "https://0xff.tf$_api_path"
}

_0xff() {
  # Preview and QR don't require auth
  if [ -n "$PREVIEW_SLUG" ]; then
    _0xff_raw=$(_api GET "/${PREVIEW_SLUG}?preview") || die "failed to preview slug '${PREVIEW_SLUG}'"
    _pretty_json "$_0xff_raw"
    return
  fi
  if [ -n "$QR_SLUG" ]; then
    _api GET "/${QR_SLUG}.qr" || die "failed to get QR code for slug '${QR_SLUG}'"
    return
  fi

  # Everything else requires auth
  [ "${SHORTENER_SECRET_KEY-}" ] || die "SHORTENER_SECRET_KEY is not set"
  AUTH=$SHORTENER_SECRET_KEY

  if [ -n "$LIST" ]; then
    _0xff_raw=$(_api GET "") || die "failed to list short URLs: $(_why "$_0xff_raw")"
  elif [ -n "$DELETE_SLUG" ]; then
    _0xff_raw=$(_api DELETE "/${DELETE_SLUG}") || die "failed to delete slug '${DELETE_SLUG}': $(_why "$_0xff_raw")"
  elif [ -n "$UPDATE_SLUG" ]; then
    _0xff_raw=$(_api PATCH "/${UPDATE_SLUG}" -H "URL: $1" ${TTL:+-H "TTL: $TTL"}) ||
      die "failed to update slug '${UPDATE_SLUG}': $(_why "$_0xff_raw")"
  else
    _0xff_raw=$(_api "$([ -n "$CUSTOM_SLUG" ] && echo PUT || echo POST)" "${CUSTOM_SLUG:+/$CUSTOM_SLUG}" \
      -H "URL: $1" ${TTL:+-H "TTL: $TTL"}) || die "failed to shorten URL: $(_why "$_0xff_raw")"
  fi
  _pretty_json "$_0xff_raw"
}

parse_params() {
  CUSTOM_SLUG=""
  DELETE_SLUG=""
  UPDATE_SLUG=""
  PREVIEW_SLUG=""
  QR_SLUG=""
  LIST=""
  TTL=""
  _pp_url=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h | --help)    usage; exit 0 ;;
      -V | --verbose) set -x ;;
      -c | --custom)
        [ "${2-}" ] || die 2 "missing slug after $1"
        CUSTOM_SLUG="$2"
        shift
        ;;
      -u | --update)
        [ "${2-}" ] || die 2 "missing slug after $1"
        UPDATE_SLUG="$2"
        shift
        ;;
      -d | --delete)
        [ "${2-}" ] || die 2 "missing slug after $1"
        DELETE_SLUG="$2"
        shift
        ;;
      -t | --ttl)
        [ "${2-}" ] || die 2 "missing seconds after $1"
        TTL="$2"
        shift
        ;;
      -p | --preview)
        [ "${2-}" ] || die 2 "missing slug after $1"
        PREVIEW_SLUG="$2"
        shift
        ;;
      -q | --qr)
        [ "${2-}" ] || die 2 "missing slug after $1"
        QR_SLUG="$2"
        shift
        ;;
      -l | --list) LIST="1" ;;
      -?*) die 2 "unknown option: $1\nTry '$PROG_NAME -h' for more information." ;;
      *)   _pp_url="$1" ;;
    esac
    shift
  done

  if [ -n "$LIST" ] || [ -n "$DELETE_SLUG" ] || [ -n "$PREVIEW_SLUG" ] || [ -n "$QR_SLUG" ]; then
    _0xff
    return
  fi

  [ -n "$_pp_url" ] || die 2 "URL is required unless listing, deleting, previewing, or getting QR.\nTry '$PROG_NAME -h' for more information."

  _0xff "$_pp_url"
}

parse_params "$@"
