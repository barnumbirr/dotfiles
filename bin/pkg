#!/bin/sh
#
# pkg - APT magic
#

set -eu

PROG_NAME="${0##*/}"
BACKUP_DIRECTORY="/var/backups/apt"

msg() { printf '%s: %b\n' "$PROG_NAME" "$*" >&2; }

die() {
  _die_rc=1
  case "${1-}" in [0-9]*) _die_rc="$1"; shift ;; esac
  msg "error: $*"
  exit "$_die_rc"
}

usage() {
  cat <<EOF
Usage: $PROG_NAME <command> [args]

Commands:
  backup [DIR]    save installed/marked packages, GPG keys and sources
  files PKG...    list files installed to system from package
  list PATTERN... list all known packages matching one or more patterns
  lock PKG...     lock package to currently installed version
  restore [DIR]   restore backup from directory
  search PATTERN... search for packages that own files corresponding to the given patterns
  unlock PKG...   unlock previously locked package

Options:
  -h, --help      display this help message and exit
EOF
}

require_root() {
  [ "$(id -u)" -eq 0 ] || die "permission denied, please run as root"
}

cmd_backup() {
  _bk_dir="${1:-$BACKUP_DIRECTORY}"

  if [ ! -d "$_bk_dir" ]; then
    mkdir -pv "$_bk_dir"
  else
    msg "directory $_bk_dir already exists, skipping creation..."
  fi

  cp -R /etc/apt/sources.list* "$_bk_dir/"
  # Copy directory contents (dir/.): copying a directory into one that exists nests it
  mkdir -p "$_bk_dir/system-keyrings"
  cp -R /usr/share/keyrings/. "$_bk_dir/system-keyrings/"
  if [ -d /etc/apt/keyrings ]; then
    mkdir -p "$_bk_dir/apt-keyrings"
    cp -R /etc/apt/keyrings/. "$_bk_dir/apt-keyrings/"
  fi
  dpkg --get-selections > "$_bk_dir/packages.txt"
  apt-mark showauto > "$_bk_dir/marked.txt" 2>/dev/null

  echo "Backup completed. Files saved to $_bk_dir"
}

cmd_files() {
  dpkg-query --listfiles "$@"
}

cmd_list() {
  dpkg-query --list "$@"
}

cmd_lock() {
  apt-mark hold "$@"
}

cmd_restore() {
  _rs_dir="${1:-$BACKUP_DIRECTORY}"

  cp -R "$_rs_dir/system-keyrings/." /usr/share/keyrings/
  cp -R "$_rs_dir/sources.list"* /etc/apt/
  if [ -d "$_rs_dir/apt-keyrings" ]; then
    mkdir -p /etc/apt/keyrings
    cp -R "$_rs_dir/apt-keyrings/." /etc/apt/keyrings/
  fi
  _rs_tmp=$(mktemp)
  apt-cache dumpavail > "$_rs_tmp" || { rm -f "$_rs_tmp"; die "apt-cache dumpavail failed"; }
  dpkg --merge-avail "$_rs_tmp" || { rm -f "$_rs_tmp"; die "dpkg --merge-avail failed"; }
  rm -f "$_rs_tmp"
  dpkg --clear-selections
  dpkg --set-selections < "$_rs_dir/packages.txt"
  xargs -r apt-mark auto < "$_rs_dir/marked.txt"

  echo "Selections restored. Ready to install."
  printf 'Run apt-get dselect-upgrade to apply? (y/n): '
  read -r _rs_confirm
  case "$_rs_confirm" in
    y | Y)
      apt-get dselect-upgrade -y
      echo "Restore completed."
      ;;
    *)
      echo "Skipped. Run 'apt-get dselect-upgrade' manually to apply."
      ;;
  esac
}

cmd_search() {
  dpkg-query --search "$@"
}

cmd_unlock() {
  apt-mark unhold "$@"
}

parse_params() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h | --help)    usage; exit 0 ;;
      -V | --verbose) set -x ;;
      backup)  require_root; shift; cmd_backup "${1-}"; return ;;
      files)   shift; [ "${1-}" ] || die 2 "PKG is required"; cmd_files "$@"; return ;;
      list)    shift; [ "${1-}" ] || die 2 "PATTERN is required"; cmd_list "$@"; return ;;
      lock)    require_root; shift; [ "${1-}" ] || die 2 "PKG is required"; cmd_lock "$@"; return ;;
      restore) require_root; shift; cmd_restore "${1-}"; return ;;
      search)  shift; [ "${1-}" ] || die 2 "PATTERN is required"; cmd_search "$@"; return ;;
      unlock)  require_root; shift; [ "${1-}" ] || die 2 "PKG is required"; cmd_unlock "$@"; return ;;
      -?*) die 2 "unknown option: $1\nTry '$PROG_NAME -h' for more information." ;;
      *)   die 2 "unknown command: $1\nTry '$PROG_NAME -h' for more information." ;;
    esac
    shift
  done

  die 2 "missing command.\nTry '$PROG_NAME -h' for more information."
}

parse_params "$@"
