#!/bin/sh
#
# git-branches - Per branch git history
#

set -eu

PROG_NAME="${0##*/}"

die() {
  _die_rc=1
  case "${1-}" in [0-9]*) _die_rc="$1"; shift ;; esac
  printf '%s: error: %b\n' "$PROG_NAME" "$*" >&2
  exit "$_die_rc"
}

usage() {
  cat <<EOF
Usage: $PROG_NAME [options]

Show last commit date, author, and name for each remote branch.

Options:
  -V, --verbose   output debug information
  -h, --help      display this help message and exit
EOF
}

main() {
  GIT_DIR=$(git rev-parse --git-dir 2>/dev/null) ||
    { [ -d ".dotfiles" ] && GIT_DIR=".dotfiles"; } ||
    die "not a git repository"

  export GIT_DIR

  printf "%-56s%-25s%-s\n" "Commit Date" "Commit Author" "Branch"
  printf "%-56s%-25s%-s\n" "-----------" "-------------" "------"
  git for-each-ref --sort=-committerdate --exclude='refs/remotes/*/HEAD' \
    --format='%(align:56,left)%(committerdate:iso) (%(committerdate:relative))%(end)%(align:25,left)%(authorname)%(end)%(refname:lstrip=3)' \
    refs/remotes
}

parse_params() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h | --help)    usage; exit 0 ;;
      -V | --verbose) set -x ;;
      -?*) die 2 "unknown option: $1\nTry '$PROG_NAME -h' for more information." ;;
      *)   break ;;
    esac
    shift
  done

  main "$@"
}

parse_params "$@"
