#!/bin/sh
#
# weather - weather forecast from Open-Meteo, laid out like wttr.in
# https://open-meteo.com/, https://github.com/chubin/wttr.in
#

set -eu

PROG_NAME="${0##*/}"
DAYS=3
E=$(printf '\033')
TAB=$(printf '\t')

die() {
  _die_rc=1
  case "${1-}" in [0-9]*) _die_rc="$1"; shift ;; esac
  printf '%s: error: %b\n' "$PROG_NAME" "$*" >&2
  exit "$_die_rc"
}

usage() {
  cat <<EOF
Usage: $PROG_NAME [options] [LOCATION]

Display the weather forecast from Open-Meteo, laid out like wttr.in: now, then
morning, noon, evening and night for $DAYS days.

Options:
  -l, --location LOCATION   return weather for location (default: Clémency, Luxembourg)
  -n, --narrow              show only noon and night

  -V, --verbose             output debug information
  -h, --help                display this help message and exit
EOF
}

# ---------------------------------------------------------------------------
# WMO weather code → icon name + description
# Sets: _wmo_icon, _wmo_desc
# ---------------------------------------------------------------------------
wmo_lookup() {
  case "$1" in
    0)     _wmo_icon=Sunny;                _wmo_desc="Clear sky" ;;
    1)     _wmo_icon=Sunny;                _wmo_desc="Mainly clear" ;;
    2)     _wmo_icon=PartlyCloudy;         _wmo_desc="Partly cloudy" ;;
    3)     _wmo_icon=VeryCloudy;           _wmo_desc="Overcast" ;;
    45|48) _wmo_icon=Fog;                  _wmo_desc="Fog" ;;
    51|53) _wmo_icon=LightRain;            _wmo_desc="Light drizzle" ;;
    55)    _wmo_icon=HeavyRain;            _wmo_desc="Dense drizzle" ;;
    56|57) _wmo_icon=LightSleet;           _wmo_desc="Freezing drizzle" ;;
    61)    _wmo_icon=LightShowers;         _wmo_desc="Slight rain" ;;
    63)    _wmo_icon=HeavyShowers;         _wmo_desc="Moderate rain" ;;
    65)    _wmo_icon=HeavyRain;            _wmo_desc="Heavy rain" ;;
    66|67) _wmo_icon=LightSleet;           _wmo_desc="Freezing rain" ;;
    71|77) _wmo_icon=LightSnow;            _wmo_desc="Light snow" ;;
    73)    _wmo_icon=LightSnow;            _wmo_desc="Moderate snow" ;;
    75)    _wmo_icon=HeavySnow;            _wmo_desc="Heavy snow" ;;
    80)    _wmo_icon=LightShowers;         _wmo_desc="Light showers" ;;
    81|82) _wmo_icon=HeavyShowers;         _wmo_desc="Heavy showers" ;;
    85)    _wmo_icon=LightSnowShowers;     _wmo_desc="Light snow showers" ;;
    86)    _wmo_icon=HeavySnowShowers;     _wmo_desc="Heavy snow showers" ;;
    95)    _wmo_icon=ThunderyHeavyRain;    _wmo_desc="Thunderstorm" ;;
    96|99) _wmo_icon=ThunderyHeavyRain;    _wmo_desc="Thunderstorm with hail" ;;
    *)     _wmo_icon=Unknown;              _wmo_desc="Unknown" ;;
  esac
}

# The icons of wttr.in's text renderer (internal/renderer/v1/icons.go): 5 lines, 13 columns each
# Sets: _icon_1 .. _icon_5
set_icon() {
  case "$1" in
    Sunny)
      _icon_1="${E}[38;5;226m    \\   /    ${E}[0m"
      _icon_2="${E}[38;5;226m     .-.     ${E}[0m"
      _icon_3="${E}[38;5;226m  ― (   ) ―  ${E}[0m"
      _icon_4="${E}[38;5;226m     \`-’     ${E}[0m"
      _icon_5="${E}[38;5;226m    /   \\    ${E}[0m"
      ;;
    PartlyCloudy)
      _icon_1="${E}[38;5;226m   \\  /${E}[0m      "
      _icon_2="${E}[38;5;226m _ /\"\"${E}[38;5;250m.-.    ${E}[0m"
      _icon_3="${E}[38;5;226m   \\_${E}[38;5;250m(   ).  ${E}[0m"
      _icon_4="${E}[38;5;226m   /${E}[38;5;250m(___(__) ${E}[0m"
      _icon_5="             "
      ;;
    Cloudy)
      _icon_1="             "
      _icon_2="${E}[38;5;250m     .--.    ${E}[0m"
      _icon_3="${E}[38;5;250m  .-(    ).  ${E}[0m"
      _icon_4="${E}[38;5;250m (___.__)__) ${E}[0m"
      _icon_5="             "
      ;;
    VeryCloudy)
      _icon_1="             "
      _icon_2="${E}[38;5;240;1m     .--.    ${E}[0m"
      _icon_3="${E}[38;5;240;1m  .-(    ).  ${E}[0m"
      _icon_4="${E}[38;5;240;1m (___.__)__) ${E}[0m"
      _icon_5="             "
      ;;
    LightShowers)
      _icon_1="${E}[38;5;226m _\`/\"\"${E}[38;5;250m.-.    ${E}[0m"
      _icon_2="${E}[38;5;226m  ,\\_${E}[38;5;250m(   ).  ${E}[0m"
      _icon_3="${E}[38;5;226m   /${E}[38;5;250m(___(__) ${E}[0m"
      _icon_4="${E}[38;5;111m     ‘ ‘ ‘ ‘ ${E}[0m"
      _icon_5="${E}[38;5;111m    ‘ ‘ ‘ ‘  ${E}[0m"
      ;;
    HeavyShowers)
      _icon_1="${E}[38;5;226m _\`/\"\"${E}[38;5;240;1m.-.    ${E}[0m"
      _icon_2="${E}[38;5;226m  ,\\_${E}[38;5;240;1m(   ).  ${E}[0m"
      _icon_3="${E}[38;5;226m   /${E}[38;5;240;1m(___(__) ${E}[0m"
      _icon_4="${E}[38;5;21;1m   ‚‘‚‘‚‘‚‘  ${E}[0m"
      _icon_5="${E}[38;5;21;1m   ‚’‚’‚’‚’  ${E}[0m"
      ;;
    LightSnowShowers)
      _icon_1="${E}[38;5;226m _\`/\"\"${E}[38;5;250m.-.    ${E}[0m"
      _icon_2="${E}[38;5;226m  ,\\_${E}[38;5;250m(   ).  ${E}[0m"
      _icon_3="${E}[38;5;226m   /${E}[38;5;250m(___(__) ${E}[0m"
      _icon_4="${E}[38;5;255m     *  *  * ${E}[0m"
      _icon_5="${E}[38;5;255m    *  *  *  ${E}[0m"
      ;;
    HeavySnowShowers)
      _icon_1="${E}[38;5;226m _\`/\"\"${E}[38;5;240;1m.-.    ${E}[0m"
      _icon_2="${E}[38;5;226m  ,\\_${E}[38;5;240;1m(   ).  ${E}[0m"
      _icon_3="${E}[38;5;226m   /${E}[38;5;240;1m(___(__) ${E}[0m"
      _icon_4="${E}[38;5;255;1m    * * * *  ${E}[0m"
      _icon_5="${E}[38;5;255;1m   * * * *   ${E}[0m"
      ;;
    LightSleetShowers)
      _icon_1="${E}[38;5;226m _\`/\"\"${E}[38;5;250m.-.    ${E}[0m"
      _icon_2="${E}[38;5;226m  ,\\_${E}[38;5;250m(   ).  ${E}[0m"
      _icon_3="${E}[38;5;226m   /${E}[38;5;250m(___(__) ${E}[0m"
      _icon_4="${E}[38;5;111m     ‘ ${E}[38;5;255m*${E}[38;5;111m ‘ ${E}[38;5;255m* ${E}[0m"
      _icon_5="${E}[38;5;255m    *${E}[38;5;111m ‘ ${E}[38;5;255m*${E}[38;5;111m ‘  ${E}[0m"
      ;;
    ThunderyShowers)
      _icon_1="${E}[38;5;226m _\`/\"\"${E}[38;5;250m.-.    ${E}[0m"
      _icon_2="${E}[38;5;226m  ,\\_${E}[38;5;250m(   ).  ${E}[0m"
      _icon_3="${E}[38;5;226m   /${E}[38;5;250m(___(__) ${E}[0m"
      _icon_4="${E}[38;5;228;5m    ⚡${E}[38;5;111;25m‘‘${E}[38;5;228;5m⚡${E}[38;5;111;25m‘‘ ${E}[0m"
      _icon_5="${E}[38;5;111m    ‘ ‘ ‘ ‘  ${E}[0m"
      ;;
    ThunderyHeavyRain)
      _icon_1="${E}[38;5;240;1m     .-.     ${E}[0m"
      _icon_2="${E}[38;5;240;1m    (   ).   ${E}[0m"
      _icon_3="${E}[38;5;240;1m   (___(__)  ${E}[0m"
      _icon_4="${E}[38;5;21;1m  ‚‘${E}[38;5;228;5m⚡${E}[38;5;21;25m‘‚${E}[38;5;228;5m⚡${E}[38;5;21;25m‚‘ ${E}[0m"
      _icon_5="${E}[38;5;21;1m  ‚’‚’${E}[38;5;228;5m⚡${E}[38;5;21;25m’‚’  ${E}[0m"
      ;;
    ThunderySnowShowers)
      _icon_1="${E}[38;5;226m _\`/\"\"${E}[38;5;250m.-.    ${E}[0m"
      _icon_2="${E}[38;5;226m  ,\\_${E}[38;5;250m(   ).  ${E}[0m"
      _icon_3="${E}[38;5;226m   /${E}[38;5;250m(___(__) ${E}[0m"
      _icon_4="${E}[38;5;255m     *${E}[38;5;228;5m⚡${E}[38;5;255;25m*${E}[38;5;228;5m⚡${E}[38;5;255;25m* ${E}[0m"
      _icon_5="${E}[38;5;255m    *  *  *  ${E}[0m"
      ;;
    LightRain)
      _icon_1="${E}[38;5;250m     .-.     ${E}[0m"
      _icon_2="${E}[38;5;250m    (   ).   ${E}[0m"
      _icon_3="${E}[38;5;250m   (___(__)  ${E}[0m"
      _icon_4="${E}[38;5;111m    ‘ ‘ ‘ ‘  ${E}[0m"
      _icon_5="${E}[38;5;111m   ‘ ‘ ‘ ‘   ${E}[0m"
      ;;
    HeavyRain)
      _icon_1="${E}[38;5;240;1m     .-.     ${E}[0m"
      _icon_2="${E}[38;5;240;1m    (   ).   ${E}[0m"
      _icon_3="${E}[38;5;240;1m   (___(__)  ${E}[0m"
      _icon_4="${E}[38;5;21;1m  ‚‘‚‘‚‘‚‘   ${E}[0m"
      _icon_5="${E}[38;5;21;1m  ‚’‚’‚’‚’   ${E}[0m"
      ;;
    LightSnow)
      _icon_1="${E}[38;5;250m     .-.     ${E}[0m"
      _icon_2="${E}[38;5;250m    (   ).   ${E}[0m"
      _icon_3="${E}[38;5;250m   (___(__)  ${E}[0m"
      _icon_4="${E}[38;5;255m    *  *  *  ${E}[0m"
      _icon_5="${E}[38;5;255m   *  *  *   ${E}[0m"
      ;;
    HeavySnow)
      _icon_1="${E}[38;5;240;1m     .-.     ${E}[0m"
      _icon_2="${E}[38;5;240;1m    (   ).   ${E}[0m"
      _icon_3="${E}[38;5;240;1m   (___(__)  ${E}[0m"
      _icon_4="${E}[38;5;255;1m   * * * *   ${E}[0m"
      _icon_5="${E}[38;5;255;1m  * * * *    ${E}[0m"
      ;;
    LightSleet)
      _icon_1="${E}[38;5;250m     .-.     ${E}[0m"
      _icon_2="${E}[38;5;250m    (   ).   ${E}[0m"
      _icon_3="${E}[38;5;250m   (___(__)  ${E}[0m"
      _icon_4="${E}[38;5;111m    ‘ ${E}[38;5;255m*${E}[38;5;111m ‘ ${E}[38;5;255m*  ${E}[0m"
      _icon_5="${E}[38;5;255m   *${E}[38;5;111m ‘ ${E}[38;5;255m*${E}[38;5;111m ‘   ${E}[0m"
      ;;
    Fog)
      _icon_1="             "
      _icon_2="${E}[38;5;251m _ - _ - _ - ${E}[0m"
      _icon_3="${E}[38;5;251m  _ - _ - _  ${E}[0m"
      _icon_4="${E}[38;5;251m _ - _ - _ - ${E}[0m"
      _icon_5="             "
      ;;
    *)
      _icon_1="    .-.      "
      _icon_2="     __)     "
      _icon_3="    (        "
      _icon_4="     \`-’     "
      _icon_5="      •      "
      ;;
  esac
}


# ---------------------------------------------------------------------------
# Geocode: location string → lat/lon/name
# Sets: _geo_lat, _geo_lon, _geo_name
# ---------------------------------------------------------------------------
geocode() {
  _geo_enc=$(printf '%s' "$1" | jq -sRr @uri)
  if ! _geo_json=$(curl --disable --fail --silent --max-time 10 \
    "https://geocoding-api.open-meteo.com/v1/search?name=${_geo_enc}&count=1"); then
    die "geocoding request failed"
  fi

  _geo_lat=$(printf '%s' "$_geo_json" | jq -r '.results[0].latitude // empty')
  [ -n "$_geo_lat" ] || die "location not found: $1"
  _geo_lon=$(printf '%s' "$_geo_json" | jq -r '.results[0].longitude // empty')
  _geo_name=$(printf '%s' "$_geo_json" | jq -r '
    .results[0] | [.name, .admin1 // empty, .country // empty]
    | map(select(. != "")) | join(", ")')
}

# ---------------------------------------------------------------------------
# Fetch forecast JSON
# Sets: _fc_json
# ---------------------------------------------------------------------------
fetch_forecast() {
  _fc_vars="temperature_2m,apparent_temperature,weather_code,wind_speed_10m,wind_gusts_10m,wind_direction_10m,visibility,precipitation"
  _fc_url="https://api.open-meteo.com/v1/forecast?latitude=${1}&longitude=${2}&timezone=auto&forecast_days=${DAYS}"
  _fc_url="${_fc_url}&current=${_fc_vars}&hourly=${_fc_vars},precipitation_probability"

  if ! _fc_json=$(curl --disable --fail --silent --max-time 10 "$_fc_url"); then
    die "forecast request failed"
  fi
}

# The forecast as rows, formatted the way wttr.in's v1 renderer does (internal/renderer/v1/format.go):
#   C <code> <temperature> <wind> <visibility> <rain>   current conditions
#   D <date label>                                      a day, then its four slots:
#   S <code> <temperature> <wind> <visibility> <rain>   09:00, 12:00, 18:00 and 22:00
# Each S field is padded to 15 columns; colours follow wttr.in's temperature and wind scales.
# shellcheck disable=SC2016 # a jq program, not shell
ROWS='
def esc: "\u001b";
def num: round | if . == 0 then 0 else . end;
def paint(c; s): esc + "[38;5;" + ("00\(c)" | .[-3:]) + "m" + s + esc + "[0m";
def pad(n): (gsub("\u001b\\[[0-9;]*m"; "") | length) as $l | if $l < n then . + esc + "[0m" + (" " * (n - $l)) else . end;
def temp_col: if . < -15 then 165 elif . <= -13 then 171 elif . <= -10 then 33 elif . <= -7 then 39
  elif . <= -4 then 45 elif . <= -1 then 51 elif . <= 1 then 50 elif . <= 3 then 49 elif . <= 5 then 48
  elif . <= 7 then 47 elif . <= 9 then 46 elif . <= 12 then 82 elif . <= 15 then 118 elif . <= 18 then 154
  elif . <= 21 then 190 elif . <= 24 then 226 elif . <= 27 then 220 elif . <= 30 then 214 elif . <= 33 then 208
  elif . <= 36 then 202 else 196 end;
def wind_col: if . <= 3 then 82 elif . <= 6 then 118 elif . <= 9 then 154 elif . <= 12 then 190
  elif . <= 15 then 226 elif . <= 19 then 220 elif . <= 23 then 214 elif . <= 27 then 208
  elif . <= 31 then 202 else 196 end;
def temp(t; plus): paint(t | temp_col; (if plus then "+" else "" end) + "\(t)");
def temp_field(t; f):
  if f != t then temp(t; t > 0) + "(" + temp(f; f > 0 and t <= 0) + ") °C" else temp(f; false) + " °C" end;
def arrow: ["↓", "↙", "←", "↖", "↑", "↗", "→", "↘"][(. / 22.5 | round) % 16 / 2 | floor];
def wind_field(d; s; g): esc + "[1m" + (d | arrow) + esc + "[0m " + paint(s | wind_col; "\(s)")
  + (if g > s then "-" + paint(g | wind_col; "\(g)") else "" end) + " km/h";
def mm: . * 10 | round / 10 | tostring | if test("\\.") then . else . + ".0" end;
def cond(c; t; f; d; s; g; v; p): {code: c, t: (t | num), f: (f | num), d: (d // 0), s: (s | num),
  g: (g | num), v: ([v / 1000, 10] | min | num), p: (p // 0)};
def row(pp): [.code, temp_field(.t; .f), wind_field(.d; .s; .g), "\(.v) km",
  (.p | mm) + " mm" + (if pp == null then "" else " | \(pp)%" end)];
(.current | cond(.weather_code; .temperature_2m; .apparent_temperature; .wind_direction_10m;
  .wind_speed_10m; .wind_gusts_10m; .visibility; .precipitation) | ["C"] + row(null) | @tsv),
(.hourly as $h | ([$h.time[][:10]] | unique)[] as $day |
  (["D", "  " + ($day | strptime("%Y-%m-%d") | strftime("%a %d %b")) + " "] | @tsv),
  ([9, 12, 18, 22][] as $hour | ($h.time | index($day + "T" + ("0\($hour)" | .[-2:]) + ":00")) as $i |
    cond($h.weather_code[$i]; $h.temperature_2m[$i]; $h.apparent_temperature[$i]; $h.wind_direction_10m[$i];
      $h.wind_speed_10m[$i]; $h.wind_gusts_10m[$i]; $h.visibility[$i]; $h.precipitation[$i])
    | ["S"] + (row($h.precipitation_probability[$i] // 0) | .[0:1] + (.[1:] | map(pad(15)))) | @tsv))
'

# wttr.in cuts or pads a forecast description to 15 columns and ends a cut one in "…"
# Sets: _desc
desc_field() {
  _desc=$(printf '%-15.15s' "$1")
  case $_desc in *" ") ;; *) _desc="${_desc%?}…" ;; esac
}

print_day() {
  if [ "$NARROW" = true ]; then
    printf '%24s┌─────────────┐\n' ''
    printf '┌───────────────────────┤%s├───────────────────────┐\n' "$_day"
    printf '│             Noon      └──────┬──────┘      Night            │\n'
    printf '├──────────────────────────────┼──────────────────────────────┤\n'
    printf '%s│\n' "$_l1" "$_l2" "$_l3" "$_l4" "$_l5"
    printf '└──────────────────────────────┴──────────────────────────────┘\n'
  else
    printf '%55s┌─────────────┐\n' ''
    printf '┌──────────────────────────────┬───────────────────────┤%s├───────────────────────┬──────────────────────────────┐\n' "$_day"
    printf '│            Morning           │             Noon      └──────┬──────┘     Evening           │             Night            │\n'
    printf '├──────────────────────────────┼──────────────────────────────┼──────────────────────────────┼──────────────────────────────┤\n'
    printf '%s│\n' "$_l1" "$_l2" "$_l3" "$_l4" "$_l5"
    printf '└──────────────────────────────┴──────────────────────────────┴──────────────────────────────┴──────────────────────────────┘\n'
  fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
  command -v jq >/dev/null 2>&1 || die "jq is required but not installed"

  geocode "$LOCATION"
  fetch_forecast "$_geo_lat" "$_geo_lon"
  _rows=$(printf '%s' "$_fc_json" | jq -r "$ROWS") || die "unexpected forecast data"

  printf 'Weather report: %s\n\n' "$LOCATION"
  _day=""
  while IFS="$TAB" read -r _kind _code _temp _wind _vis _rain; do
    case "$_kind" in
      C)
        wmo_lookup "$_code"
        set_icon "$_wmo_icon"
        printf '  %s %s\n' "$_icon_1" "$_wmo_desc" "$_icon_2" "$_temp" "$_icon_3" "$_wind" \
          "$_icon_4" "$_vis" "$_icon_5" "$_rain"
        ;;
      D)
        [ -z "$_day" ] || print_day
        _day="$_code"
        _slot=0
        _l1="" _l2="" _l3="" _l4="" _l5=""
        ;;
      S)
        _slot=$((_slot + 1))
        # Narrow keeps noon and night, the 2nd and 4th slots
        if [ "$NARROW" = true ] && [ $((_slot % 2)) -eq 1 ]; then continue; fi
        wmo_lookup "$_code"
        set_icon "$_wmo_icon"
        desc_field "$_wmo_desc"
        _l1="$_l1│ $_icon_1 $_desc"
        _l2="$_l2│ $_icon_2 $_temp"
        _l3="$_l3│ $_icon_3 $_wind"
        _l4="$_l4│ $_icon_4 $_vis"
        _l5="$_l5│ $_icon_5 $_rain"
        ;;
    esac
  done <<EOF
$_rows
EOF
  print_day
  printf 'Location: %s [%s,%s]\n' "$_geo_name" "$_geo_lat" "$_geo_lon"
}

parse_params() {
  LOCATION=""
  NARROW=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h | --help)    usage; exit 0 ;;
      -V | --verbose) set -x ;;
      -l | --location)
        [ "${2-}" ] || die 2 "missing value after $1"
        LOCATION="$2"
        shift
        ;;
      -n | --narrow)  NARROW=true ;;
      -?*) die 2 "unknown option: $1\nTry '$PROG_NAME -h' for more information." ;;
      *)   break ;;
    esac
    shift
  done

  [ -n "${1-}" ] && LOCATION="$1"
  LOCATION="${LOCATION:-Clémency, Luxembourg}"

  main
}

parse_params "$@"
